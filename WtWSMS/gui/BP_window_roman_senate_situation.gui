	type BP_senate_widget_character = widget {
		size = { 220 210 }
		
		tooltipwidget = {
			container_character_tooltip = {}
		}
		
		blockoverride "portrait_button"
		{
			using = tooltip_ne
		}
		
		blockoverride "glow_visible"
		{
			visible = no
		}
		
		using = Character_Background
		
		portrait_button = {
			visible = "[Character.IsValid]"
			parentanchor = hcenter
			name = portrait
			position = { 0 -25 }
			size = { 200 210 }
			
			using = portrait_base
			
			block "portrait_texture"
			{
				portrait_texture = "[Character.GetAnimatedPortrait( 'environment_hud', 'camera_torso', 'idle', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
			}
			background_texture = "gfx/portraits/portrait_transparent.dds"
			effectname = "NoHighlight"
			texture = "gfx/portraits/portrait_transparent.dds"
			mask = "gfx/portraits/portrait_mask_torso.dds"
		}
		#empty_char = {
		#	visible = "[Not(Character.IsValid)]"
		#	position = { 55 10 }
		#	block "tooltip"
		#	{ tooltip = "SENATE_SINE_COLLEGA" }
		#}
		
		portrait_status_icons = {
			parentanchor = bottom|right
			position = { -5 -60 }
		}
		
		coa_realm_small_crown = {
			visible = "[Character.HasLandedTitles]"
			parentanchor = bottom|left
			position = { -5 -60 }
		}
		
		portrait_opinion = {
			parentanchor = bottom|hcenter
			position = { 0 -60 }
		}
		
		widget = {
			parentanchor = bottom|hcenter
			size = { 220 70 }
			
			vbox = {
				layoutpolicy_horizontal = expanding
				parentanchor = center
				
				hbox = {
					layoutpolicy_horizontal = expanding
					min_height = 52
					margin = { 5 5 }
					
					background = {
						using = Background_Area_Solid
						margin = { 10 0 }
					}
					
					background = {
						using = GenericObjectCardHeaderBackground
						using = Color_Red
						margin = { 10 0 }
					}
					
					icon = {
						size = { 40 40 }
						block "icon_texture"
						{
							texture = "[Character.GetGovernment.GetIcon]"
						}
					}
					
					### TITLE & NAME ###
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						
						margin = { 10 0 }
						
						expand = {}
						
						text_single = {
							visible = "[Character.IsValid]"
							layoutpolicy_horizontal = expanding
							
							text = "[Character.GetShortUINameNotMeNoTooltip|U]"
							align = nobaseline
							max_width = 150
						}
						text_single = {
							visible = "[Not(Character.IsValid)]"
							layoutpolicy_horizontal = expanding
							
							
							text = "WESTERN_SENATE_CONSUL_DESIGNATE_NONE_NAME"
							align = nobaseline
							max_width = 150
						}
						
						text_single = {
							layoutpolicy_horizontal = expanding
							
							block "portrait_title"
							{
								text = "WESTERN_SENATE_CONSULS"
								tooltip = "roman_consul_west_desc"
							}
							align = nobaseline
							max_width = 150
						}
						
						expand = {}
					}
				}
			}
		}
	}
	
	type BP_senate_family_window = window {
		name = "BP_senate_family_window"
		widgetanchor = right
		position = { 30 100 }
		size = { 740 82% }
		
		layer = middle
		movable = yes
		
		using = Window_Background
		using = Window_Decoration_Spike
		
		state = {
			name = _show
			using = Animation_FadeIn_Quick
			on_start = "[GetScriptedGui('get_senate_families_effect').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
		}
		
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			on_start = "[GetScriptedGui('clear_senate_families_effect').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			on_start = "[GetVariableSystem.Set('senate_family_window','false')]"
		}
		
		vbox = {
			using = Window_Margins
			
			header_pattern = {
				layoutpolicy_horizontal = expanding
				
				blockoverride "header_text"
				{
					text = "senate_families"
				}
				
				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Set('senate_family_window','false')]"
				}
			}
			
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 8 0 }
				margin_bottom = 4
				
				background = {
					using = Background_Area
					margin = { 0 4 }
				}
				
				spacer = { size = { 15 15 } }
				
				vbox = {
					layoutpolicy_horizontal = expanding
					visible = "[ObjectsEqual( Situation.GetSubRegionByKey('west').Self, SituationSubRegion.Self )]"
					
					text_label_center = {
						text = "WESTERN_SENATE_DYNASTIES"
						default_format = "#T"
					}
					
					
					scrollbox = {
						name = "senate_house_list"
						parentanchor = top
						layoutpolicy_vertical = shrinking
						layoutpolicy_horizontal = shrinking
						size = { 600 600 }
						
						blockoverride "scrollbox_margins" {}
						blockoverride "scrollbox_content"
						{
							
							vbox = {
								parentanchor = left
								layoutpolicy_vertical = expanding
								
								fixedgridbox = {
									datamodel = "[GetSituation('BP_senate').MakeScope.GetList('senate_family_list_west')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									addcolumn = 600
									addrow = 124
									item = {
										bp_senate_dynasty_group_item = {
										
											blockoverride "number_senators" { text = "DYNASTY_TT_NUMBER_OF_SENATORS_WEST" }
										}
									}
								}
							}
						}
					}
				}
				
				vbox = {
					layoutpolicy_horizontal = expanding
					visible = "[ObjectsEqual( Situation.GetSubRegionByKey('east').Self, SituationSubRegion.Self )]"
					
					text_label_center = {
						text = "EASTERN_SENATE_DYNASTIES"
						default_format = "#T"
					}
					
					scrollbox = {
						name = "senate_house_list"
						parentanchor = top
						layoutpolicy_vertical = shrinking
						layoutpolicy_horizontal = shrinking
						size = { 600 600 }
						
						blockoverride "scrollbox_margins" {}
						blockoverride "scrollbox_content"
						{
							
							vbox = {
								parentanchor = left
								layoutpolicy_vertical = expanding
								
								fixedgridbox = {
									datamodel = "[GetSituation('BP_senate').MakeScope.GetList('senate_family_list_east')]"
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									addcolumn = 600
									addrow = 124
									item = {
										bp_senate_dynasty_group_item = {
										
											blockoverride "number_senators" { text = "DYNASTY_TT_NUMBER_OF_SENATORS_EAST" }
										}
									}
								}
							}
						}
					}
				}
			}
			
		}
	}
	type bp_senate_dynasty_group_item = vbox {
		layoutpolicy_horizontal = expanding
		widget = {
			datacontext = "[Scope.Dynasty]"
			layoutpolicy_horizontal = shrinking
			size = { 580 118 }
			using = Background_Area_Administrative_Decoration
			
			hbox = {
				max_width = 580
				layoutpolicy_horizontal = expanding
				margin = { 5 -5 }
				coa_dynasty_big = {
				}
				
				vbox = {
					max_width = 315
					layoutpolicy_horizontal = expanding
					
					ignoreinvisible = no
						
						text_single = {
							parentanchor = top|left
							layoutpolicy_horizontal = expanding
							
							text = "SENATE_DYNASTY_WITH_NAME"
							align = nobaseline
							max_width = 315
							using = Font_Size_Medium
						}
					
					cooltip_paragraph = {
						text = "DYNASTY_VIEW_HOUSES_AMOUNT"
						max_width = 315
						multiline = no
					}
					
					cooltip_paragraph = {
						block "number_senators"
						{
							text = "DYNASTY_TT_NUMBER_OF_SENATORS_WEST"
						}
						max_width = 315
						multiline = no
					}
					
					cooltip_paragraph = {
						text = "DYNASTY_TT_NUMBER_OF_SENATE_HOLDINGS"
						max_width = 315
						multiline = no
					}

					expand = {}
				}
				
				
				vbox = {
					datacontext = "[Dynasty.GetDynast]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					
					hbox_bp_featured_senate_family_head_portrait = {}
				}
				
				expand = {}
			}
		}
		expand = {}
	}
	
	type hbox_bp_featured_senate_family_head_portrait = hbox
	{
		background = {
			using = Background_Area
			alpha = 1.2

			margin = { 8 4 }
		}

		vbox = {
			spacing = 2
			layoutpolicy_vertical = expanding


			expand = {}

			widget_access_domicile_button = {
				datacontext = "[Dynasty.GetDynast]"
				datacontext = "[Character.GetDomicile]"
				visible = "[Character.HasDomicile]"
			}

			button_round = {
				visible = "[Not( Character.IsPlayer )]"

				tooltip = "SENATE_DYNASTY_INTERACTIONS_BUTTON_TOOLTIP"
				tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, 'senate'))]"

				onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'senate')]"

				button_icon = {
					alwaystransparent = yes
					parentanchor = center
					size = { 30 30 }
					texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
				}

				text_single = {
					parentanchor = bottom|hcenter
					position = { 0 3 }
					text = "[GetNumberOfValidInteractionsWithFilter(Character.Self, 'senate')]"
					default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

					background = {
						margin = { 5 0 }
						margin_top = -5
						using = Background_Area_Dark
					}
				}

			}

			expand = {}
		}

		block "portrait_head"
		{
			portrait_head_small = {}
		}
	}
}


#Cribbed from gui/shared/cooltip.gui
template SenateDynastyTooltipWest {
	object_tooltip_pop_out = {
		
		blockoverride "header_additions" {
			margin_top = 6
			margin_bottom = -10
			
			coa_dynasty_small = {
				blockoverride "coa_tooltip" {}
			}
		}
		
		blockoverride "title_text" {
			#margin = { 0 8 }
			margin_right = 16
			text = "[dynasty|E] [Dynasty.GetNameNoTooltip]"
			align = nobaseline
		}
		
		blockoverride "concept_link" {
			text = [dynasty|E]
		}
		
		blockoverride "extra_data" {
			cooltip_paragraph = {
				text = "DYNASTY_VIEW_MY_DYNASTY"
				visible = "[Dynasty.IsMyDynasty(GetPlayer)]"
			}
			
			cooltip_paragraph = {
				datacontext = [Dynasty]
				text = "DYNASTY_TT_DYNAST"
			}
			
			cooltip_paragraph = {
				datacontext = [Dynasty]
				text = "DYNASTY_TT_SPLENDOR_LEVEL"
			}
			
			cooltip_paragraph = {
				text = "DYNASTY_VIEW_PRESTIGE"
			}
			
			cooltip_paragraph = {
				datacontext = [Dynasty]
				text = "DYNASTY_TT_MEMBERS"
			}
			
			cooltip_paragraph = {
				datacontext = [Dynasty]
				text = "DYNASTY_TT_NUMBER_OF_SENATORS_WEST"
			}
			
			cooltip_paragraph = {
				datacontext = [Dynasty]
				text = "DYNASTY_TT_NUMBER_OF_HOLDINGS_WEST"
			}
			
		}
	}
}

